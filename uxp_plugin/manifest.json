{
  "manifestVersion": 5,
  "id": "com.ecommerce.photoshop.panel",
  "name": "E-Commerce Ready Edit",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ecommercePanel",
      "label": {
        "default": "E-Commerce Ready Edit"
      },
      "minimumSize": {
        "width": 300,
        "height": 450
      },
      "maximumSize": {
        "width": 520,
        "height": 900
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 600
      },
      "icons": [
        {
          "width": 32,
          "height": 32,
          "path": "assets/logo.png"
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": true,
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "schemes": [
        "https",
        "http"
      ]
    }
  },
  "icons": [
    {
      "width": 32,
      "height": 32,
      "path": "assets/logo.png"
    }
  ]
}